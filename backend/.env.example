# AI Content Platform - Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for ISR revalidation callbacks)
FRONTEND_URL=https://thereadroom.vercel.app

# Database Connection (Supabase PostgreSQL)
# Pooler URL for runtime (uses PgBouncer)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct URL for migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# OpenAI / Groq API
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Admin Security (change in production!)
ADMIN_SECRET=super_secret_admin_key_12345
